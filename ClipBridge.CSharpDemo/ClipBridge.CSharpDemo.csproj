<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\x64\$(Configuration)\ClipBridge.Native.dll" Link="ClipBridge.Native.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\x64\$(Configuration)\ClipBridge.Native.dll')" />
  </ItemGroup>
</Project>
